{
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/backend/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/backend",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
