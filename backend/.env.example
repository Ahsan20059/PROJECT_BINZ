# MongoDB
MONGO_URI=mongodb://localhost:27017/binzDB

# Server port
PORT=5000

# Long random value used to sign the 24-hour, HTTP-only authentication session cookie.
# Required in production.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated frontend origins that may send session cookies (required in production).
CLIENT_ORIGIN=https://your-frontend.example.com

# Twilio (used by POST /sendSMS — optional, pickup booking still works if these are blank)
twilioAccountSid=
twilioAuthToken=

# Gmail (used by POST /submit-ticket confirmation email — optional, ticket still gets created if this fails)
# Use a Gmail App Password, not your normal Gmail password.
EMAIL_USER=
EMAIL_PASS=

# Admin API key for e-waste tracking status updates
ADMIN_API_KEY=change-this-admin-key
